{
  "name": "escalada-paraules",
  "version": "0.6.2",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:ladders": "node scripts/generateLadders.mjs",
    "generate:games": "node scripts/generateGames.mjs",
    "prepare:dict": "node scripts/prepareDictionary.mjs",
    "prepare:dict:ca": "node scripts/prepareDictionary.mjs raw/ca.txt public/dictionaries/ca.txt --lang ca",
    "prepare:dict:es": "node scripts/prepareDictionary.mjs raw/es.txt public/dictionaries/es.txt --lang es",
    "audit:dict:ca": "node scripts/auditDictionary.mjs ca",
    "audit:dict:es": "node scripts/auditDictionary.mjs es",
    "check:games:ca": "node scripts/checkGames.mjs ca",
    "check:games:es": "node scripts/checkGames.mjs es"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "jsdom": "^24.0.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/jest-dom": "^6.4.0"
  }
}
